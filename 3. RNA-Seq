# R

# Install biocmanager for DESeq2

if (!requireNamespace("BiocManager", quietly=TRUE))
    install.packages("BiocManager")
BiocManager::install("DESeq2")

# load DESeq2
library(DESeq2)

counts <- read.table( # load counts table .tsv into R
  "gene_counts.tsv",
  header=TRUE,
  row.names=1
)

condition <- factor(c( # set condition for each group, mutant and normal, 5 individuals for each
  rep("normal", 5),
  rep("mutant", 5)
))

coldata <- data.frame(row.names=colnames(counts), condition) # create a dataframe for this

dds <- DESeqDataSetFromMatrix( # store dataframe, counts and condition in to dds object
  countData = counts,
  colData = coldata,
  design = ~ condition
)

dds <- DESeq(dds) # run DESeq2 analysis on dds
res <- results(dds) # create object for results

# order by most significant p-value
res <- res[order(res$padj), ] # order results by significance 
 summary(res) # summary of results in this order 

# order again by significance, using specific p-value threshold < 0.01
res0.01 <- results(dds, alpha = 0.01)
res0.01 <- res0.01[order(res0.01$padj), ]
summary(res0.01)

# Differential expression results 
resultsNames(dds)
# MA plot
plotMA(res)

# Alternative plot for visualisation, volcano plot:
summary(res)
head(res[order(res$padj), ])

library(ggplot2)

res <- results(dds, alpha=0.01, contrast=c("condition", "mutant", "normal"))
res_df <- as.data.frame(res)

# Significance labels for upregulation/downregulation 
res_df$significance <- "Not Significant" # label for no significance seen 
res_df$significance[res_df$padj < 0.01 & res_df$log2FoldChange >  1] <- "Up" # upregulated, defined by p < 0.01 and log2FC > 1
res_df$significance[res_df$padj < 0.01 & res_df$log2FoldChange < -1] <- "Down" # downregulated with p < 0.01, but log2FC of < -1 
res_df$significance <- factor(res_df$significance, levels=c("Up", "Down", "Not Significant")) # labels for key on plot 

res_df <- res_df[!is.na(res_df$padj) & !is.na(res_df$log2FoldChange), ] # remove na rows from dataframe before plotting 

# Volcano plot
ggplot(res_df, aes(x=log2FoldChange, y=-log10(padj), color=significance)) +
  geom_point(alpha=0.6, size=1.5) + 
  scale_color_manual(values=c("Up"="firebrick", "Down"="steelblue", "Not Significant"="grey60")) + 
  geom_vline(xintercept=c(-1, 1), linetype="dashed", color="black", linewidth=0.4) +
  geom_hline(yintercept=-log10(0.01), linetype="dashed", color="black", linewidth=0.4) +
  labs(
    title="Volcano Plot: Mutant vs Normal",
    x="Log2 Fold Change",
    y="-Log10 Adjusted P-value",
    color="Regulation"
  ) +
  theme_minimal(base_size=13) +
  theme(legend.position="right")

summary(res) # results summary 
resultsNames(dds) # comparison sumary of dds 
plotMA(res, ylim=c(-5, 5))

head(res_df[order(res_df$padj), ]) # top significant genes (head)
