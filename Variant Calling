# Variant Calling

# Ubuntu:

cd gene_x
bwa index GeneX_reference.fa

bwa mem \
GeneX_reference.fa \
mutant_GeneX_R1.fastq \
mutant_GeneX_R2.fastq \
> mutant.sam

samtools view -bS mutant.sam | \
samtools sort -o mutant.sorted.bam

samtools index mutant.sorted.bam
samtools flagstat mutant.sorted.bam

bcftools mpileup \
-f GeneX_reference.fa \
mutant.sorted.bam | \
bcftools call -mv --ploidy 1 -Ov \
-o mutant.vcf

grep -v "^#" mutant.vcf

# One tailed Binomial testing in R for identified SNPs

# Position 493

binom.test(
  x = 95, # allele reads (mutant)
  n = 246, # total reads at position
  p = 0.01,
  alternative = "greater"
)

