# R

de_genes <- rownames(res) # list the genes in rnaseq results 

bound_genes <- read.table( # load genes identified in cut&run analysis into R
  "results/cutrun_genes.txt",
  stringsAsFactors = FALSE
)$V1

direct_targets <- intersect(de_genes, bound_genes) # identify genes that appear in both files (direct targets of gene x)

length(direct_targets) # print the number of these 
[1] 54

# Filter for significance - differentially expressed and overlapping genes 
> sig_01 <- subset(
  res,
  padj < 0.01 &
  abs(log2FoldChange) > 1 # up and down regulation
)

nrow(sig_01) # number of genes (rows) when filtered using p < 0.01
[1] 36

de_genes <- rownames(sig_01) # edit de_genes file to only included the 36 significant genes 

bound_genes <- read.table( # reload cut&run bound genes 
  "results/cutrun_genes.txt",
  stringsAsFactors = FALSE
)$V1

direct_targets <- intersect(de_genes, bound_genes) # create an object for direct targets (those seen in both file objects 

length(direct_targets) # print number of direct targets of gene x
[1] 5

